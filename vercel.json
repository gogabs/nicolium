{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.17.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.17.0 -F pl-api build && npx --yes pnpm@11.17.0 -F nicolium build",
  "outputDirectory": "packages/nicolium/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
